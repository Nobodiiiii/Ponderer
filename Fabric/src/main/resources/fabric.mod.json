{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "mixins": [
    "ponderer.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.nododiiiii.ponderer.fabric.PondererFabric"
    ],
    "client": [
      "com.nododiiiii.ponderer.fabric.PondererFabricClient"
    ],
    "modmenu": [
      "com.nododiiiii.ponderer.fabric.compat.PondererModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "com.nododiiiii.ponderer.compat.jei.PondererJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  },
  "suggests": {
    "jei": ">=${jei_version}",
    "modmenu": "*",
    "resourcify": ">=1.0.0"
  }
}
